    e8QuestionIdx: 0, e8Doc: `C`, e8Tested: [0],
    t6: { impact: 5, feas: 4 },
    t7: { ...E9_PRESETS[`Incoming correspondence and memo routing`], process: `Incoming correspondence and memo routing` },
    t8Skills: [{ skill: `Stores Procedure Writing`, evidence: `Wrote manual used by ~200 storekeepers across 6 zones`, level: `4`, who: `Cooperatives & SMEs`, use: `Practical handbook / training course` }],
    t8Lesson: { sit: ``, rule: `` },
    t9: { purpose: ``, paths: ``, learning: ``, checks: [] },
    promptPillar: `ALL`, savedPrompts: [],
    t10: { week1: ``, m1: ``, partner: ``, exitUse: `0`, exitConf: `0` },
    gainLog: [{ task: `Notes to action list (Pack A test)`, before: 60, after: 12, errors: 3 }]
  };

  const ta = document.getElementById(`e1-title-card`);
  const env = document.getElementById(`e1-sealed-envelope`);
  const sealBtn = document.getElementById(`e1-seal-btn`);
  if (ta) ta.disabled = false;
