    html += `<button type="button" class="btn-secondary btn-sm ${active ? `btn-active` : ``}" style="justify-content: flex-start; text-align: left;" onclick="selectE8Question(${idx})"><span class="index-num" style="color: inherit;">Q${idx + 1}</span> ${item.q}</button>`;
  });
  wrap.innerHTML = html;
}

function selectE8Question(idx) {
  appState.e8QuestionIdx = idx;
  if (!appState.e8Tested.includes(idx)) appState.e8Tested.push(idx);
  renderE8Questions();

  const q = E8_QUESTIONS[idx];
  const ansBox = document.getElementById(`e8-answer-box`);
  if (q && ansBox) {
    ansBox.innerHTML = `<span class="tag tag-slate" style="margin-bottom: 0.4rem;">Notebook Grounded Answer</span>\n${q.ans}\n\n<button type="button" class="btn-secondary btn-sm" style="margin-top: 0.6rem;" onclick="highlightE8Citation('${q.doc}', '${q.clause}')">Verify Citation in Pack ${q.doc} (${q.clause})</button>`;
    highlightE8Citation(q.doc, q.clause, true);
  }
  saveState();
}

function selectE8Doc(docKey, highlightClause) {
  appState.e8Doc = docKey;
  [`C`, `D`, `E`].forEach((k) => {
    const b = document.getElementById(`e8-doc-${k}`);
    if (b) b.classList.toggle(`btn-active`, k === docKey);
  });

  const viewer = document.getElementById(`e8-doc-viewer`);
  const doc = E8_DOCS[docKey];
  if (!viewer || !doc) return;

  let html = `<div style="font-weight: 700; margin-bottom: 0.6rem; color: var(--secondary);">${doc.title}</div>`;
  doc.clauses.forEach((c) => {
    const isHit = highlightClause === c.id;
    html += `<div id="clause-${c.id}" class="doc-clause ${isHit ? `cited-hit` : ``}">${c.text}</div>`;
  });
  viewer.innerHTML = html;
}

function highlightE8Citation(docKey, clauseId, skipScroll) {
  selectE8Doc(docKey, clauseId);
  const target = document.getElementById(`clause-${clauseId}`);
  if (target && !skipScroll) {
    target.scrollIntoView({ block: `nearest`, behavior: `smooth` });
  }
}

function renderPackFTable() {
  const tbody = document.getElementById(`pack-f-table`);
  if (!tbody) return;
  let html = ``;
  PACK_F_DATA.forEach((z) => {
    const compPct = ((z.completed / z.planned) * 100).toFixed(1);
    const utilPct = ((z.utilised / z.released) * 100).toFixed(1);
    const rowCls = z.status === `alert` ? `row-alert` : (z.zone === `Lagos` ? `row-highlight` : ``);
    html += `
      <tr class="${rowCls}">
        <td><strong>${z.zone}</strong></td>
        <td class="num-col">${z.planned}</td>
        <td class="num-col">${z.completed} (${compPct}%)</td>
        <td class="num-col">₦${z.utilised}m (${utilPct}%)</td>
        <td class="num-col">${z.turnaround.toFixed(1)}d</td>
        <td class="num-col">${z.q2}%</td>
      </tr>
    `;
  });
  tbody.innerHTML = html;
}

function renderPackFChart() {
  const canvas = document.getElementById(`pack-f-chart`);
  if (!canvas || typeof Chart === `undefined`) return;
  if (packFChartInstance) packFChartInstance.destroy();

  const styles = getComputedStyle(document.documentElement);
  const c1 = styles.getPropertyValue(`--data-1`).trim();
  const c2 = styles.getPropertyValue(`--data-2`).trim();
  const c4 = styles.getPropertyValue(`--data-4`).trim();

  const labels = PACK_F_DATA.map((d) => d.zone);
  const compRates = PACK_F_DATA.map((d) => Number(((d.completed / d.planned) * 100).toFixed(1)));
  const utilRates = PACK_F_DATA.map((d) => Number(((d.utilised / d.released) * 100).toFixed(1)));
  const compColors = PACK_F_DATA.map((d) => d.zone === `Kano` ? c4 : c1);

  packFChartInstance = new Chart(canvas.getContext(`2d`), {
    type: `bar`,
    data: {
      labels: labels,
      datasets: [
        { label: `Completion Rate %`, data: compRates, backgroundColor: compColors },
        { label: `Budget Utilisation %`, data: utilRates, backgroundColor: c2 }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: `bottom` }
      },
      scales: {
        y: { beginAtZero: true, max: 110, title: { display: true, text: `Percentage (%)` } }
      }
    }
  });
}

function toggleD7Brief() {
  const panel = document.getElementById(`d7-brief-panel`);
  const btn = document.getElementById(`d7-brief-btn`);
  if (!panel || !btn) return;
  const open = panel.style.display === `block`;
  panel.style.display = open ? `none` : `block`;
  btn.textContent = open ? `Show Management Brief & 3 DG Questions` : `Hide Management Brief`;
}

function applyProcessPreset() {
  const sel = document.getElementById(`t7-process`);
  if (!sel) return;
  const preset = E9_PRESETS[sel.value];
  if (!preset) return;
  document.getElementById(`t6-impact`).value = preset.impact;
  document.getElementById(`t6-feas`).value = preset.feas;
  document.getElementById(`t7-dataclass`).value = preset.dataclass;
  document.getElementById(`t7-before`).value = preset.before;
  document.getElementById(`t7-after`).value = preset.after;
  document.getElementById(`t7-checkpoint`).value = preset.checkpoint;
  document.getElementById(`t7-measure`).value = preset.measure;
  updatePitch();
}

function updatePitch(skipSave) {
  const g = (id) => { const el = document.getElementById(id); return el ? el.value : ``; };
  const imp = Math.min(5, Math.max(1, parseInt(g(`t6-impact`), 10) || 1));
  const feas = Math.min(5, Math.max(1, parseInt(g(`t6-feas`), 10) || 1));
  const scoreEl = document.getElementById(`t6-score-val`);
  if (scoreEl) scoreEl.textContent = String(imp * feas);

  appState.t6 = { impact: imp, feas: feas };
  appState.t7 = {
    process: g(`t7-process`),
    dataclass: g(`t7-dataclass`),
    before: g(`t7-before`),
    after: g(`t7-after`),
    checkpoint: g(`t7-checkpoint`),
    measure: g(`t7-measure`)
  };

  const pitchEl = document.getElementById(`t7-pitch-preview`);
  if (pitchEl) {
    pitchEl.textContent = `"We will move ${appState.t7.process} from ${appState.t7.before} to ${appState.t7.after}, with a human checkpoint where ${appState.t7.checkpoint}, needing ${appState.t7.dataclass}, measured by ${appState.t7.measure}."`;
  }
  if (!skipSave) saveState();
}

function copyWorkflowDesign() {
  updatePitch();
  const pitch = document.getElementById(`t7-pitch-preview`).textContent;
  const txt = `OPPORTUNITY SCORE (T6): ${appState.t6.impact * appState.t6.feas}/25\nWORKFLOW PITCH (T7): ${pitch}`;
  copyTextToClipboard(txt, `t7-copy-status`, `Workflow pitch & T6/T7 design copied!`);
