async function saveState() {
  const badge = document.getElementById(`save-status-badge`);
  try {
    if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === `function`) {
      await window.notebookAppApi.setAppState(appState);
      if (badge) badge.textContent = `Saved`;
    }
  } catch (err) {
    if (badge) badge.textContent = `Session Active`;
  }
  updateMasteryProgress();
}

async function initApp() {
  try {
    if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === `function`) {
      const loaded = await window.notebookAppApi.getAppState();
      if (loaded && typeof loaded === `object`) {
        appState = { ...appState, ...loaded };
      }
    }
  } catch (err) {
    // Fallback gracefully to initial state
  }

  hydrateAllInputs();
  setD1View(`raw`);
  renderE2Cards();
  renderCatalystRail();
  setCatalystStep(appState.catalystStep || 0);
  setD2Mode(`weak`);
  updateAuditHours(true);
  renderContextCard(true);
  setE5Pack(appState.e5Pack || `A`);
  setE6Step(appState.e6Step || 1);
  renderE6Log();
  renderT5Presets();
  renderE8Questions();
  selectE8Doc(appState.e8Doc || `C`);
  selectE8Question(appState.e8QuestionIdx || 0);
  renderPackFTable();
  renderPackFChart();
  updatePitch(true);
  renderT8Skills();
  renderT9Checklist();
  renderPromptLibrary();
  renderGainLog();
  updateMasteryProgress();

  if (window.lucide && typeof window.lucide.createIcons === `function`) {
    window.lucide.createIcons();
  }
  if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === `function`) {
    window.notebookAppApi.notifyAppReady();
  }
}

