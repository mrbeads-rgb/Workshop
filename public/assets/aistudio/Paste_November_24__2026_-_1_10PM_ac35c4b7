// 10. PROMPT LIBRARY (P1-P24) & CLOSING (T10 + GAIN LOG)
// =========================================================================

function setPromptPillar(pillar, btn) {
  appState.promptPillar = pillar;
  const tabs = document.getElementById(`prompt-pillar-tabs`);
  if (tabs) {
    Array.from(tabs.querySelectorAll(`button`)).forEach((b) => b.classList.remove(`btn-active`));
  }
  if (btn) btn.classList.add(`btn-active`);
  renderPromptLibrary();
}

function renderPromptLibrary() {
  const grid = document.getElementById(`prompt-library-grid`);
  if (!grid) return;
  const search = (document.getElementById(`prompt-search`)?.value || ``).toLowerCase().trim();
  const dataF = document.getElementById(`prompt-data-filter`)?.value || `ALL`;

  const filtered = PROMPTS.filter((p) => {
    if (appState.promptPillar !== `ALL` && p.pillar !== appState.promptPillar) return false;
    if (dataF !== `ALL` && p.data !== dataF) return false;
    if (search && !(`${p.id} ${p.title} ${p.when} ${p.prompt}`.toLowerCase().includes(search))) return false;
    return true;
  });

  if (filtered.length === 0) {
    grid.innerHTML = `<div class="figure-card"><p class="muted">No prompts match that filter. Clear the search box or switch back to All (24).</p></div>`;
    return;
  }

  let html = ``;
  filtered.forEach((p) => {
    const isSaved = appState.savedPrompts.includes(p.id);
    const dataTagCls = p.data === `Green` ? `tag-green` : `tag-amber`;
    const placeholders = Array.from(new Set((p.prompt.match(/\[([A-Z0-9_]+)\]/g) || []).filter((x) => x !== `[MISSING]` && x !== `[UNCLEAR]` && x !== `[CHECK]` && x !== `[VERIFY]`)));

    let placeholderInputs = ``;
    placeholders.forEach((ph) => {
      const clean = ph.replace(/\[|\]/g, ``).replace(/_/g, ` `);
      placeholderInputs += `
        <div class="form-field">
          <label class="field-label" for="ph-${p.id}-${clean}">${clean}</label>
          <input type="text" id="ph-${p.id}-${clean}" data-ph="${ph}" placeholder="Enter ${clean.toLowerCase()}...">
        </div>
      `;
    });

    html += `
      <article class="prompt-card" id="card-${p.id}">
        <div class="dossier-bar" style="margin-bottom: var(--space-xs);">
          <div class="dossier-bar-left">
            <span class="index-num">${p.id}</span>
            <span class="tag tag-slate">Pillar ${p.pillar}</span>
            <span class="tag ${dataTagCls}">${p.data}</span>
          </div>
          <button type="button" class="btn-secondary btn-sm ${isSaved ? `btn-active` : ``}" onclick="toggleSavePrompt('${p.id}')">${isSaved ? `Saved to T4` : `Save to T4`}</button>
        </div>
        <h3 class="subhead" style="margin: 0;">${p.title}</h3>
        <p class="muted" style="margin: 0;"><strong>Use when:</strong> ${p.when}</p>
        <div class="prompt-text-box">${p.prompt}</div>
        <p class="muted" style="margin: 0;"><strong>Verify before use:</strong> ${p.verify}</p>

        <details>
          <summary>Customise Placeholders &amp; Copy (${placeholders.length} fields)</summary>
          <div style="padding-top: var(--space-sm);">
            <div class="form-grid">${placeholderInputs || `<p class="muted">No custom placeholders needed—ready to copy!</p>`}</div>
            <div class="btn-row" style="margin-top: var(--space-sm);">
              <button type="button" class="btn-primary btn-sm" onclick="copyCustomPrompt('${p.id}')">Copy Tailored Prompt</button>
              <span class="inline-status" id="copy-msg-${p.id}"></span>
            </div>
          </div>
        </details>
      </article>
    `;
  });

  grid.innerHTML = html;
}

function toggleSavePrompt(id) {
  const idx = appState.savedPrompts.indexOf(id);
  if (idx >= 0) appState.savedPrompts.splice(idx, 1);
  else appState.savedPrompts.push(id);
  renderPromptLibrary();
  saveState();
}

function copyCustomPrompt(id) {
  const p = PROMPTS.find((x) => x.id === id);
  const card = document.getElementById(`card-${id}`);
  if (!p || !card) return;

  let text = p.prompt;
  const inputs = card.querySelectorAll(`input[data-ph]`);
  inputs.forEach((inp) => {
    const val = inp.value.trim();
    if (val) {
      text = text.split(inp.dataset.ph).join(val);
    }
  });
  copyTextToClipboard(text, `copy-msg-${id}`, `Prompt ${id} copied to clipboard!`);
}

function saveClosing() {
  const g = (id) => { const el = document.getElementById(id); return el ? el.value : ``; };
  appState.t10 = {
    week1: g(`t10-week1`),
    m1: g(`t10-m1`),
    partner: g(`t10-partner`),
    exitUse: g(`exit-use`),
    exitConf: g(`exit-conf`)
  };
  saveState();
}

function addGainLogEntry() {
  const task = document.getElementById(`gain-task`).value.trim();
  const before = parseInt(document.getElementById(`gain-before`).value, 10) || 0;
  const after = parseInt(document.getElementById(`gain-after`).value, 10) || 0;
  const errors = parseInt(document.getElementById(`gain-errors`).value, 10) || 0;
  if (!task) return;

  appState.gainLog.push({ task, before, after, errors });
  document.getElementById(`gain-task`).value = ``;
  renderGainLog();
  saveState();
}

function renderGainLog() {
  const tbody = document.getElementById(`gain-log-body`);
  const totalEl = document.getElementById(`gain-total-saved`);
  if (!tbody) return;

  let totalSaved = 0;
  let html = ``;
  appState.gainLog.forEach((row) => {
    const saved = Math.max(0, row.before - row.after);
    totalSaved += saved;
    html += `
      <tr>
        <td>${row.task}</td>
        <td class="num-col">${saved} min</td>
        <td class="num-col">${row.errors}</td>
      </tr>
    `;
  });
  tbody.innerHTML = html;
  if (totalEl) totalEl.textContent = `${totalSaved} min saved`;
}

// =========================================================================
// 11. UTILITIES: CLIPBOARD, DOWNLOAD WORKBOOK, INLINE RESET
// =========================================================================

function copyTextToClipboard(text, statusElId, successMsg) {
  const el = document.getElementById(statusElId);
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(() => {
      if (el) el.textContent = successMsg;
    }).catch(() => {
      if (el) el.textContent = `Copy ready—select text manually if blocked.`;
    });
  } else if (el) {
    el.textContent = `Copy ready—select text manually.`;
  }
}

