<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="artifact-type" content="narrative">
<meta name="design-style" content="briefing">
<title>The AI-Powered Productive Life — Interactive Masterclass</title>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@1.43.0/dist/umd/lucide.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<style>
:root {
  color-scheme: light;

  /* 1. Briefing Style Tokens */
  --background: #faf9f5;
  --surface-container-low: #ffffff;
  --surface-container: #f1efe8;
  --surface-container-high: #e6e2d6;

  --on-surface: #17181a;
  --on-surface-variant: #56585c;

  --outline: #17181a;
  --outline-variant: #dedad0;
  --border-subtle: #c8c4b8;

  --primary: #17181a;
  --on-primary: #faf9f5;
  --primary-container: #f2b705;
  --on-primary-container: #17181a;
  --secondary: #1f4e5f;
  --secondary-soft: #e7f0f3;
  --tertiary: #785008;
  --tertiary-soft: #f5e6c4;
  --error: #b42318;
  --error-soft: #fbeae8;
  --on-error: #ffffff;

  --data-1: #1f4e5f;
  --data-2: #d99000;
  --data-3: #2b6e52;
  --data-4: #b84a39;
  --data-context: #c4bfb2;

  --font-headline: 'Source Serif 4', serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --font-label: 'Geist Mono', monospace;

  --rounded: 0.25rem;
  --rounded-lg: 0.375rem;
  --rounded-full: 0.25rem;

  --section-rule: 1.5px solid var(--outline);
  --card-border: 1px solid var(--outline-variant);
  --badge-radius: 2px;
  --heading-tracking: -0.02em;
  --label-tracking: 0.08em;

  /* 2. Shared Tokens */
  --positive: #2b6e52;
  --positive-soft: #e6f2ec;
  --warning: #8a5a00;
  --warning-soft: #fef3c7;
  --focus: #1f4e5f;

  /* Narrative Type Scale */
  --display-size: clamp(2.35rem, 1.4rem + 3.4vw, 4rem);
  --headline-size: clamp(1.65rem, 1.2rem + 1.6vw, 2.35rem);
  --subhead-size: clamp(1.18rem, 1.05rem + 0.45vw, 1.4rem);
  --body-size: clamp(1rem, 0.96rem + 0.18vw, 1.0625rem);
  --label-size: clamp(0.75rem, 0.72rem + 0.12vw, 0.8125rem);

  /* Spacing Scale */
  --space-xs: 0.25rem;
  --space-sm: 0.5rem;
  --space-md: 1rem;
  --space-lg: 1.5rem;
  --space-xl: 2.5rem;
  --space-2xl: 4rem;
  --space-3xl: 5.5rem;

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-micro: 120ms;
  --dur-short: 220ms;
  --dur-long: 420ms;
}

/* Base Reset */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body {
  overflow-x: clip;
  margin: 0;
  padding: 0;
  background-color: var(--background);
  color: var(--on-surface);
  font-family: var(--font-body);
  font-size: var(--body-size);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
header { position: static !important; }

.page-shell {
  max-width: 1180px;
  margin: 0 auto;
  padding: var(--space-lg) var(--space-lg) var(--space-3xl);
}
.page-shell * { min-width: 0; }

/* Focus Ring */
:focus-visible {
  outline: 2.5px solid var(--focus);
  outline-offset: 2px;
}

/* Dossier Section Bars & Typography */
.dossier-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  border-bottom: var(--section-rule);
  padding-bottom: var(--space-sm);
  margin-bottom: var(--space-md);
}
.dossier-bar-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
}
.dossier-pill {
  display: inline-block;
  background: var(--primary-container);
  color: var(--on-primary-container);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 0.6875rem;
  letter-spacing: var(--label-tracking);
  text-transform: uppercase;
  padding: 0.22rem 0.55rem;
  border-radius: var(--badge-radius);
}
.dossier-meta {
  font-family: var(--font-label);
  font-size: var(--label-size);
  color: var(--on-surface-variant);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.hero-title {
  font-family: var(--font-headline);
  font-weight: 600;
  font-size: var(--display-size);
  letter-spacing: var(--heading-tracking);
  line-height: 1.07;
  color: var(--on-surface);
  margin: var(--space-sm) 0 var(--space-md);
  max-width: 18ch;
}
.section-title {
  font-family: var(--font-headline);
  font-weight: 600;
  font-size: var(--headline-size);
  letter-spacing: var(--heading-tracking);
  line-height: 1.12;
  color: var(--on-surface);
  margin: 0 0 var(--space-xs);
}
.subhead {
  font-family: var(--font-headline);
  font-weight: 600;
  font-size: var(--subhead-size);
  line-height: 1.25;
  color: var(--on-surface);
  margin: 0 0 var(--space-xs);
}
.standfirst {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
  color: var(--secondary);
  line-height: 1.45;
  margin: 0 0 var(--space-lg);
  max-width: 68ch;
}
.prose {
  max-width: 65ch;
  color: var(--on-surface);
  margin: 0 0 var(--space-md);
}
.muted {
  color: var(--on-surface-variant);
  font-size: 0.9375rem;
}
.index-num {
  font-family: var(--font-label);
  font-weight: 600;
  font-size: var(--label-size);
  color: var(--secondary);
  letter-spacing: 0.04em;
}
.tabular {
  font-variant-numeric: lining-nums tabular-nums;
}

/* Sections & Rhythm */
.module-section {
  margin-top: var(--space-3xl);
  scroll-margin-top: var(--space-lg);
}
.module-section:first-of-type {
  margin-top: var(--space-xl);
}

/* Cards & Asides */
.figure-card {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-lg);
}
.figure-card-tight {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-md);
}
.aside-box {
  background: var(--surface-container);
  border-top: var(--section-rule);
  padding: var(--space-md) var(--space-lg);
  border-radius: 0 0 var(--rounded-lg) var(--rounded-lg);
}
.teacher-note {
  background: var(--surface-container);
  border-left: 3px solid var(--secondary);
  padding: var(--space-md) var(--space-lg);
  border-radius: 0 var(--rounded-lg) var(--rounded-lg) 0;
  margin: var(--space-md) 0;
}
.teacher-note-label {
  font-family: var(--font-label);
  font-size: var(--label-size);
  text-transform: uppercase;
  letter-spacing: var(--label-tracking);
  color: var(--secondary);
  font-weight: 600;
  display: block;
  margin-bottom: var(--space-xs);
}

/* Grids */
.grid-asymmetric {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
  gap: var(--space-lg);
  align-items: start;
}
.grid-2col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-lg);
}
.grid-3col {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-md);
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
  gap: var(--space-md);
}

/* Hero Top Grid & Progress Strip */
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
  gap: var(--space-xl);
  align-items: start;
}
.progress-bar-track {
  width: 100%;
  height: 10px;
  background: var(--surface-container-high);
  border-radius: var(--badge-radius);
  overflow: hidden;
  margin: var(--space-sm) 0;
}
.progress-bar-fill {
  height: 100%;
  background: var(--secondary);
  width: 0%;
  transition: width var(--dur-long) var(--ease-out);
}

/* Chapter Nav Strip */
.chapter-nav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  padding: var(--space-md) 0;
  border-top: 1px solid var(--outline-variant);
  border-bottom: 1px solid var(--outline-variant);
  margin: var(--space-lg) 0;
}
.chapter-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  min-height: 44px;
  padding: 0.4rem 0.75rem;
  text-decoration: none;
  color: var(--on-surface);
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  font-size: 0.875rem;
  font-weight: 600;
  transition: background-color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
}
.chapter-link:hover {
  background: var(--surface-container);
  border-color: var(--outline);
}
.chapter-link .num {
  font-family: var(--font-label);
  font-size: 0.75rem;
  color: var(--secondary);
}

/* Buttons */
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  align-items: center;
}
button, .btn {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  min-height: 44px;
  padding: 0.55rem 1rem;
  border-radius: var(--rounded);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
  border: 1px solid transparent;
}
.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
  border-color: var(--primary);
}
.btn-primary:hover {
  background: var(--secondary);
  border-color: var(--secondary);
}
.btn-secondary {
  background: var(--surface-container-low);
  color: var(--on-surface);
  border: 1px solid var(--border-subtle);
}
.btn-secondary:hover {
  background: var(--surface-container);
}
.btn-accent {
  background: var(--primary-container);
  color: var(--on-primary-container);
  border-color: var(--primary-container);
}
.btn-accent:hover {
  box-shadow: inset 0 0 0 1px var(--outline);
}
.btn-sm {
  min-height: 44px;
  padding: 0.4rem 0.8rem;
  font-size: 0.84rem;
}
.btn-active {
  background: var(--secondary);
  color: var(--on-primary);
  border-color: var(--secondary);
}
button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Forms & Always-Visible Labels */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
}
.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.form-field.full {
  grid-column: 1 / -1;
}
.field-label {
  font-family: var(--font-label);
  font-size: var(--label-size);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--on-surface);
  font-weight: 600;
}
.field-hint {
  font-size: 0.8125rem;
  color: var(--on-surface-variant);
}
input[type="text"],
input[type="number"],
input[type="date"],
input[type="search"],
select,
textarea {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--on-surface);
  background: var(--surface-container-low);
  border: 1px solid var(--border-subtle);
  border-radius: var(--rounded);
  padding: 0.6rem 0.75rem;
  min-height: 44px;
  width: 100%;
  transition: box-shadow var(--dur-micro) var(--ease-out);
}
select {
  padding-right: 2.25rem;
}
textarea {
  min-height: 92px;
  resize: vertical;
  line-height: 1.5;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  box-shadow: 0 0 0 2px var(--focus);
}

/* Badges & Traffic Light Pills */
.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--font-label);
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.2rem 0.5rem;
  border-radius: var(--badge-radius);
}
.tag-green { background: var(--positive-soft); color: var(--positive); }
.tag-amber { background: var(--tertiary-soft); color: var(--tertiary); }
.tag-red { background: var(--error-soft); color: var(--error); }
.tag-slate { background: var(--secondary-soft); color: var(--secondary); }
.tag-stone { background: var(--surface-container); color: var(--on-surface-variant); }

/* Tables */
.table-wrap {
  overflow-x: auto;
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  background: var(--surface-container-low);
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92rem;
}
thead th {
  font-family: var(--font-label);
  font-size: 0.74rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-align: left;
  padding: 0.75rem 0.9rem;
  background: var(--surface-container);
  border-bottom: var(--section-rule);
  color: var(--on-surface);
}
tbody td {
  padding: 0.75rem 0.9rem;
  border-bottom: 1px solid var(--outline-variant);
  vertical-align: top;
}
tbody tr:last-child td { border-bottom: none; }
tbody tr.row-highlight { background: var(--tertiary-soft); }
tbody tr.row-alert { background: var(--error-soft); }
.num-col { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-label); }

/* Interactive Module Components */
.shift-card {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-top: 3px solid var(--secondary);
  border-radius: var(--rounded-lg);
  padding: var(--space-md) var(--space-lg);
}
.pillar-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  gap: var(--space-md);
}
.pillar-card {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-sm);
}
.pillar-card .mins {
  font-family: var(--font-headline);
  font-size: 1.75rem;
  font-weight: 600;
  color: var(--secondary);
  font-variant-numeric: tabular-nums;
}

/* Traffic-Light Card Sort */
.sort-card {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.sort-choices {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}
.sort-btn {
  min-height: 44px;
  padding: 0.35rem 0.75rem;
  font-size: 0.82rem;
  border: 1px solid var(--border-subtle);
  background: var(--surface-container-low);
  color: var(--on-surface);
}
.sort-btn.chosen-green { background: var(--positive); color: var(--on-primary); border-color: var(--positive); }
.sort-btn.chosen-amber { background: var(--tertiary); color: var(--on-primary); border-color: var(--tertiary); }
.sort-btn.chosen-red { background: var(--error); color: var(--on-error); border-color: var(--error); }

.feedback-line {
  font-size: 0.875rem;
  padding: var(--space-sm);
  border-radius: var(--rounded);
  line-height: 1.45;
}
.feedback-ok { background: var(--positive-soft); color: var(--positive); }
.feedback-warn { background: var(--error-soft); color: var(--error); }

/* CATALYST Stepper */
.catalyst-rail {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: var(--space-xs);
  margin-bottom: var(--space-md);
}
.cat-step-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0.55rem 0.25rem;
  min-height: 64px;
  background: var(--surface-container-low);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  color: var(--on-surface);
  text-align: center;
}
.cat-step-btn .cat-letter {
  font-family: var(--font-headline);
  font-size: 1.35rem;
  font-weight: 700;
  line-height: 1;
}
.cat-step-btn .cat-word {
  font-family: var(--font-label);
  font-size: 0.65rem;
  text-transform: uppercase;
  margin-top: 0.25rem;
}
.cat-step-btn.active {
  background: var(--primary);
  color: var(--on-primary);
  border-color: var(--primary);
}
.cat-step-btn.active .cat-letter {
  color: var(--primary-container);
}

/* Output Previews & Code/Prompt Blocks */
.output-box {
  background: var(--surface-container);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  padding: var(--space-md);
  font-size: 0.92rem;
  white-space: pre-wrap;
  line-height: 1.55;
  color: var(--on-surface);
}
.prompt-text-box {
  font-family: var(--font-body);
  background: var(--background);
  border: 1px solid var(--outline-variant);
  border-left: 3px solid var(--secondary);
  border-radius: var(--rounded);
  padding: var(--space-md);
  font-size: 0.92rem;
  line-height: 1.55;
  white-space: pre-wrap;
}

/* Stacked Time Bar */
.stacked-bar {
  display: flex;
  height: 18px;
  border-radius: var(--badge-radius);
  overflow: hidden;
  background: var(--surface-container-high);
  margin: var(--space-sm) 0;
}
.bar-seg {
  height: 100%;
  transition: width var(--dur-short) var(--ease-out);
}
.seg-work { background: var(--data-1); }
.seg-commute { background: var(--data-2); }
.seg-family { background: var(--data-3); }
.seg-study { background: var(--data-4); }
.seg-rest { background: var(--secondary); opacity: 0.55; }

/* Grounded Notebook Citations */
.doc-pane {
  max-height: 360px;
  overflow-y: auto;
  padding: var(--space-md);
  background: var(--background);
  border: 1px solid var(--outline-variant);
  border-radius: var(--rounded);
  font-size: 0.92rem;
}
.doc-clause {
  padding: 0.4rem 0.55rem;
  border-radius: var(--rounded);
  margin-bottom: 0.35rem;
  transition: background-color var(--dur-short) var(--ease-out);
}
.doc-clause.cited-hit {
  background: var(--primary-container);
  color: var(--on-primary-container);
  font-weight: 600;
}

/* Prompt Library Cards */
.prompt-card {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-md) var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

/* Inline Toast / Status */
.inline-status {
  font-family: var(--font-label);
  font-size: 0.8rem;
  color: var(--positive);
  font-weight: 600;
}

/* Details / Collapsible Secondary Info */
details {
  background: var(--surface-container-low);
  border: var(--card-border);
  border-radius: var(--rounded-lg);
  padding: var(--space-sm) var(--space-md);
}
summary {
  font-weight: 600;
  cursor: pointer;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--secondary);
}

/* Chart container height guardrail */
.chart-box {
  position: relative;
  min-height: 320px;
  width: 100%;
}

/* Responsive Rules */
@media (max-width: 860px) {
  .hero-grid, .grid-asymmetric, .grid-2col, .grid-3col {
    grid-template-columns: 1fr;
  }
  .catalyst-rail {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
@media (max-width: 640px) {
  .page-shell {
    padding: var(--space-md) var(--space-md) var(--space-2xl);
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .catalyst-rail {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>
<body>
<div class="page-shell">

  <!-- HEADER & OPENING -->
  <header id="sec-opening">
