function updateAuditHours(skipSave) {
  const num = (id) => {
    const el = document.getElementById(id);
    return el ? Math.max(0, parseFloat(el.value) || 0) : 0;
  };
  const work = num(`t1-work`);
  const commute = num(`t1-commute`);
  const family = num(`t1-family`);
  const study = num(`t1-study`);
  const rest = num(`t1-rest`);
  const total = work + commute + family + study + rest;
  const rem = Math.round((168 - total) * 10) / 10;

  const remEl = document.getElementById(`t1-unaccounted`);
  const noteEl = document.getElementById(`t1-hours-note`);
  if (remEl) remEl.textContent = `${rem} hrs / 168 hrs`;
  if (noteEl) {
    noteEl.textContent = rem < 0
      ? `Over 168 hours—some commitments overlap or need trimming`
      : `Unstructured, transitional, or attention-leak hours`;
  }

  const setW = (id, hrs) => {
    const el = document.getElementById(id);
    if (el) el.style.width = `${Math.min(100, (hrs / Math.max(168, total)) * 100)}%`;
  };
  setW(`seg-work`, work);
  setW(`seg-commute`, commute);
  setW(`seg-family`, family);
  setW(`seg-study`, study);
  setW(`seg-rest`, rest);

  if (!skipSave) savePillar1();
}

