    pcc: { roles: ``, goals: ``, priorities: ``, constraints: ``, energy: ``, style: `` },
    t3: { outcomes: ``, block: ``, buffer: 20, score: `0` },
    e5Pack: `A`, e5Checked: [], e6Step: 1,
    e6Log: [
      { claim: `Files must be indexed within 5 working days of opening`, source: `Pack C, Clause 1: "within 5 working days"`, rung: `Source-check`, verdict: `Verified` },
